{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfsqlmigrationproject01"
		},
		"ADLS_SQL_PARQUET_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADLS_SQL_PARQUET'"
		},
		"LS_LKUP_MAX_VALUE_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_LKUP_MAX_VALUE'"
		},
		"LS_ONPrem_SQLServer_DW_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_ONPrem_SQLServer_DW'"
		},
		"LS_SQLSERVER_TBLBKP_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQLSERVER_TBLBKP'"
		},
		"ADLS_SQL_PARQUET_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlssqlmigrationproject.dfs.core.windows.net/"
		},
		"LS_LKUP_MAX_VALUE_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "DESKTOP-06NRSR8\\SQLEXPRESS"
		},
		"LS_LKUP_MAX_VALUE_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "RetailDW_Dev"
		},
		"LS_LKUP_MAX_VALUE_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sayaliphatak"
		},
		"LS_ONPrem_SQLServer_DW_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "DESKTOP-06NRSR8\\SQLEXPRESS"
		},
		"LS_ONPrem_SQLServer_DW_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "RetailDW_Dev"
		},
		"LS_ONPrem_SQLServer_DW_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sayaliphatak"
		},
		"LS_SQLSERVER_TBLBKP_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "DESKTOP-06NRSR8\\SQLEXPRESS"
		},
		"LS_SQLSERVER_TBLBKP_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "RetailDW_Dev"
		},
		"LS_SQLSERVER_TBLBKP_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sayaliphatak"
		}
